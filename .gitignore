release/

# Local Pi/agent state and research material
.pi/
.pi-docs/
.superpowers/
.impeccable/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs, coverage, and editor/OS files
*.log
coverage/
.DS_Store
.vscode/
.idea/

# Web research scratch (firecrawl CLI writes here)
.firecrawl/

# Local screenshots
ui-shot-*.png
