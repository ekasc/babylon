{
  "name": "babylon",
  "productName": "Babylon",
  "private": true,
  "version": "0.1.0",
  "description": "A secure desktop workspace for the pi coding agent",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && concurrently -k --success first -n vite,pideck \"vite\" \"node scripts/dev-electron.mjs\"",
    "build:electron": "node scripts/build-electron.mjs",
    "build:daemon": "node scripts/build-daemon.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron && npm run build:daemon",
    "dist:mac": "electron-builder --mac --arm64",
    "install:mac": "npm run build && npm run dist:mac && node scripts/install-mac.mjs",
    "start": "node scripts/ensure-electron.mjs && electron .",
    "smoke": "PIDECK_HEADLESS=1 PIDECK_SMOKE=4000 pnpm start",
    "bench:build": "node scripts/build-bench.mjs",
    "bench:snapshot": "node scripts/bench-snapshot.mjs",
    "bench:snapcompact": "tsx scripts/snapcompact-bench.mjs",
    "eval:snapcompact": "tsx scripts/snapcompact-eval.mjs",
    "prototype:sidebar": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "font-list": "^2.1.0",
    "katex": "^0.18.4",
    "mermaid": "^11.17.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.1.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
