{
  "name": "babylon",
  "productName": "Babylon",
  "private": true,
  "version": "0.1.0",
  "description": "A secure desktop workspace for the pi coding agent",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && concurrently -k --success first -n vite,pideck \"vite\" \"node scripts/dev-electron.mjs\"",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --external:electron --outfile=dist-electron/main.mjs && esbuild electron/preload.ts --bundle --platform=node --external:electron --outfile=dist-electron/preload.cjs --format=cjs",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "start": "node scripts/ensure-electron.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.1.0",
    "electron": "^37.2.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
